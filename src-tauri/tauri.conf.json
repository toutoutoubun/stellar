{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stellar",
  "version": "0.1.0",
  "identifier": "app.stellar.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Stellar",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://esm.sh; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' asset: https://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: https://asset.localhost blob: https://api.crossref.org https://api.openalex.org https://cdn.jsdelivr.net https://esm.sh https://stellar-backup.workers.dev; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPCONFIG/**",
            "$APPDATA/**",
            "$HOME/**",
            "$DESKTOP/**",
            "$DOCUMENT/**",
            "$DOWNLOAD/**",
            "$TEMP/**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "研究支援デスクトップアプリ — 文献管理・ノート・グラフビュー",
    "longDescription": "Stellar は文献管理、ノートテイキング、グラフビューを1つのアプリで完結させる、ローカルファーストの研究支援ツールです。",
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
